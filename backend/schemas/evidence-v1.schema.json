{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lablineage.dev/schemas/evidence-v1.schema.json",
  "title": "LabLineage Evidence Envelope v1",
  "type": "object",
  "required": ["schema_version", "evidence_id", "project_id", "evidence_type", "source", "captured_at", "sha256", "payload"],
  "properties": {
    "schema_version": { "const": "lablineage.evidence.v1" },
    "evidence_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "evidence_type": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "payload": { "type": "object" },
    "signature": {
      "type": ["object", "null"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "signer_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "value_base64": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
