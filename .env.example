GOOGLE_GENAI_API_KEY=replace-with-your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
LABLINEAGE_VERTEX_EXPRESS=TRUE
LABLINEAGE_PROXY=http://127.0.0.1:17891
LABLINEAGE_MODEL=gemini-2.5-flash
LABLINEAGE_AGENT_TIMEOUT_MS=45000
LABLINEAGE_AGENT_MAX_MODEL_CALLS=8
LABLINEAGE_AGENT_MAX_ESTIMATED_INPUT_TOKENS=150000
LABLINEAGE_EVIDENCE_LOOP_MAX_ITERATIONS=2
# Defaults are the Gemini 2.5 Flash standard list rates at documentation time;
# override them when the selected model, tier, or provider differs.
LABLINEAGE_AGENT_INPUT_USD_PER_MILLION=0.30
LABLINEAGE_AGENT_OUTPUT_USD_PER_MILLION=2.50
# Optional stable token for trusted in-process/read-only MCP clients. If empty,
# each Guardian process generates an ephemeral token and keeps the MCP endpoint internal.
LABLINEAGE_MCP_INTERNAL_TOKEN=
LABLINEAGE_PORT=8788
# Formal runtime profile. Local Collector can connect to either deployment.
LABLINEAGE_DEPLOYMENT_MODE=local
LABLINEAGE_DATA_DIR=.lablineage
LABLINEAGE_SCAN_ROOT=
LABLINEAGE_ALLOW_TEXT_DIFF=false
LABLINEAGE_SNAPSHOT_HOT_COUNT=20
LABLINEAGE_INGESTION_POLL_MS=5000
LABLINEAGE_OBJECT_STORE=local
LABLINEAGE_GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
# google_cloud mode uses Cloud Tasks to invoke the private analysis worker.
# LABLINEAGE_TASK_DISPATCHER=cloud_tasks
# LABLINEAGE_TASKS_QUEUE=lablineage-analysis
# LABLINEAGE_TASKS_LOCATION=asia-east1
# LABLINEAGE_ANALYSIS_WORKER_URL=https://example.run.app/internal/analysis-worker
# LABLINEAGE_TASKS_AUDIENCE=https://example.run.app
# LABLINEAGE_TASKS_SERVICE_ACCOUNT=lablineage-tasks@example.iam.gserviceaccount.com

# Development defaults to an explicit local actor. Production defaults to OIDC.
LABLINEAGE_AUTH_MODE=development
# LABLINEAGE_OIDC_ISSUER=https://issuer.example/
# LABLINEAGE_OIDC_AUDIENCE=lablineage-api
# LABLINEAGE_OIDC_JWKS_URL=https://issuer.example/.well-known/jwks.json
# LABLINEAGE_SERVICE_TOKENS_JSON=[{"id":"collector","sha256":"<token-sha256>","projects":["<project-id>"],"roles":["editor"]}]

# PostgreSQL production evidence store and migration settings.
# DATABASE_URL=postgresql://lablineage:password@127.0.0.1:5432/lablineage
# LABLINEAGE_DB_SSL=true
# LABLINEAGE_DB_POOL_MAX=10
# LABLINEAGE_TENANT_SLUG=example-lab
# LABLINEAGE_TENANT_NAME=Example Lab
# LABLINEAGE_AUTO_MIGRATE=false
# LABLINEAGE_SEED_DEMO=false

# Signed collector bundles. Production always requires signatures.
LABLINEAGE_REQUIRE_SIGNED_MANIFESTS=false
# LABLINEAGE_TRUSTED_COLLECTOR_KEYS=<sha256-spki-fingerprint>
LABLINEAGE_PATH_SALT=replace-with-a-random-secret

# Read-only GitHub connector.
# GITHUB_TOKEN=
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Allowlisted local Git parent directories, separated by the OS path delimiter.
# LABLINEAGE_LOCAL_GIT_ROOTS=C:\research\repos;D:\shared\verified

# Google Workspace OAuth access token; Gmail integration creates drafts only.
# GOOGLE_WORKSPACE_ACCESS_TOKEN=
# GOOGLE_WORKSPACE_CLIENT_ID=
# GOOGLE_WORKSPACE_CLIENT_SECRET=
# GOOGLE_WORKSPACE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_RANGE=Audit!A:E
